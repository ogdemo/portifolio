# Owner notification destinations
CONTACT_EMAIL_TO=ogdemo23@gmail.com
WHATSAPP_TO=0789347791

# SMTP credentials (Gmail requires an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ogdemo23@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=ogdemo23@gmail.com

# Meta WhatsApp Cloud API credentials
# Create these in Meta for Developers and keep them private.
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v23.0

# MTN Mobile Money configuration
MTN_CLIENT_ID=your_mtn_client_id_here
MTN_CLIENT_SECRET=your_mtn_client_secret_here
# Subscription key is optional and not required for this setup.
MTN_SUBSCRIPTION_KEY=
MTN_USE_SUBSCRIPTION_KEY=false
MTN_ENVIRONMENT=sandbox
MTN_API_MODE=payments
MTN_CALLBACK_URL=https://your-domain.com/api/momo/callback
MTN_SHOP_NAME=mrchicken
MTN_COUNTRY_CODE=RW
